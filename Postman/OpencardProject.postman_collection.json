      "name": "06_Delete_Cart_Item",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Check status code\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "var jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"Cart is empty\", function () {\r",
              "    pm.expect(jsonData.products).to.be.an(\"array\").that.is.empty;\r",
              "});\r",
              "\r",
              "pm.test(\"Total items is zero\", function () {\r",
              "    pm.expect(jsonData.total_items).to.eql(0);\r",
              "});\r",
              "\r",
              "pm.collectionVariables.unset(\"api_token_val\");\r",
              "pm.collectionVariables.unset(\"cart_key\");\r",
