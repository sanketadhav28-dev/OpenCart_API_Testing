              "});\r",
              "\r",
              "pm.test(\"Check product ID\", function () {\r",
              "    pm.expect(jsonData.product_id).to.eql(44);\r",
              "});\r",
              "\r",
              "pm.test(\"Check quantity\", function () {\r",
              "    pm.expect(jsonData.quantity).to.eql(6);\r",
              "});"
