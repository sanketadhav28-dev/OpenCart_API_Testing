    {
      "name": "03_Get_Cart",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Check status\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "\r",
              "    var jsonData = pm.response.json();\r",
              "\r",
              "    pm.expect(jsonData.success).to.eql(true);\r",
              "\r",
              "    pm.expect(jsonData.products[0].product_id).to.eql(44);\r",
              "\r",
              "    pm.collectionVariables.set(\"cart_key\", Number(jsonData.products[0].key));\r",
              "\r",
              "    pm.collectionVariables.set(\"cart_quantity\", jsonData.products[0].quantity);\r",
              "});"
            ],
